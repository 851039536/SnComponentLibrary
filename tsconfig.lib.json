{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* 库构建专用：只做类型声明产出，不产出 JS（JS 由 vite/rolldown 负责） */
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist-lib",
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/components/**/*.ts",
    "src/components/**/*.vue",
    "src/vite-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-lib"]
}
